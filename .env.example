SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://postgres:5432/perubilling
DATABASE_USERNAME=perubilling
DATABASE_PASSWORD=change_me
JWT_ISSUER=perubilling
JWT_SECRET=BASE64_32_OR_MORE_RANDOM_BYTES
MASTER_KEY=BASE64_32_RANDOM_BYTES
API_KEY_PEPPER=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
API_KEY_LAST_USED_WRITE_INTERVAL_SECONDS=300
ARTIFACTS_BACKEND=database
ARTIFACTS_ROOT=/data/artifacts
SUNAT_XSD_ENABLED=true
SUNAT_XSD_PATH=/opt/perubilling/sunat-xsd
PROCESSING_STALE_MINUTES=15
SUNAT_RULES_VERSION=2026-08-26
SUNAT_MAX_DIRECT_AGE_DAYS=3
SUNAT_MAX_SUMMARY_AGE_DAYS=7
SUNAT_CONSULT_URL=https://e-factura.sunat.gob.pe/ol-it-wsconscpegem/billConsultService
PUBLIC_BASE_URL=https://billing.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
PRODUCTION_GUARD_ENABLED=true
PROCESSING_MAX_RECONCILIATIONS=8
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_MS=1000
SUNAT_CDR_MAX_ZIP_BYTES=5242880
SUNAT_CDR_MAX_XML_BYTES=10485760
SUNAT_CDR_MAX_ENTRIES=8
SUNAT_CDR_MAX_COMPRESSION_RATIO=200

# Automatización de Resumen Diario
SUMMARY_AUTO_ENABLED=true
SUMMARY_AUTO_POLL_MS=900000
SUMMARY_AUTO_MIN_AGE_MINUTES=15
ARTIFACTS_REQUIRE_CHECKSUM=true
ARTIFACTS_MAX_READ_BYTES=52428800
# Backups: scripts/backup.sh y scripts/restore.sh
BACKUP_DIR=/backups
